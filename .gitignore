# Python
__pycache__/
*.py[cod]
*.egg-info/

# 构建产物
dist/
build/

# 安装包构建产物（installer/build_installer.ps1 生成）
installer/Output/
installer/models_cache/

# 本地预置模型联调目录（约 505 MB，勿提交；安装包由 iss 打入）
models/

# PyInstaller spec（保留 PaperWB.spec）
*.spec
!PaperWB.spec

# 虚拟环境
venv/
env/
.conda/
.venv/

# IDE
.vscode/
.idea/

# ZCode 工具产物（会话计划等，非项目文件）
.zcode/

# 运行时数据（含 API Key，切勿提交！）
.paperwb/
.pdfasker/
.env
*.secret

# 便携模式运行时（开发模式下直接落在仓库根：config.json、数据目录、日志）
/config.json
/data/
/logs/
.paperwb_write_probe

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 临时生成脚本（模型预热脚本是构建所需，明确保留）
_gen_*.py
!_gen_prewarm_models.py

# 废弃代码
*.deprecated

# 构建/运行日志（保留在工作区，不入库）
*.log
